:root{--bg:#05070a;--panel:#0b0f15;--line:#202936;--line2:#18202b;--text:#f3f6fa;--muted:#8792a3;--green:#72e2a3;--red:#ff7f87}
*{box-sizing:border-box}html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}body{min-height:100vh}.shell{width:min(1500px,calc(100% - 48px));margin:auto;padding:26px 0 40px}.topbar{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding:4px 0 20px}.brand{display:flex;align-items:center;gap:13px}.fia-mark{width:38px;height:38px;border:1px solid #354151;border-radius:10px;display:grid;place-items:center;font-size:11px;font-weight:800;letter-spacing:.12em;background:#0d1219}.brand-title{font-size:17px;font-weight:800;letter-spacing:.04em}.brand-sub{font-size:10px;color:var(--muted);letter-spacing:.16em;margin-top:3px}.header-status{display:flex;gap:9px;align-items:center}.status-pill{border:1px solid var(--line);background:#090d12;border-radius:7px;padding:8px 11px;font-size:10px;font-weight:800;letter-spacing:.1em;color:#aab3c0}.status-pill.live{color:var(--green)}.status-pill i{display:inline-block;width:6px;height:6px;border-radius:50%;background:currentColor;margin-right:6px}.refresh-btn{border:0;border-radius:7px;padding:8px 12px;background:#e9edf2;color:#0a0c10;font-size:11px;font-weight:900;cursor:pointer}
.hero-grid{display:grid;grid-template-columns:1.7fr .85fr;gap:18px;margin-top:18px}.hero-copy{min-height:300px;border:1px solid var(--line);border-radius:15px;padding:28px 30px;background:radial-gradient(circle at 82% 28%,#141c2a 0,#0b0f15 36%,#090c11 70%);position:relative}.eyebrow,.section-kicker{font-size:10px;font-weight:900;letter-spacing:.18em;color:#8490a1}.direction{font-size:38px;font-weight:850;letter-spacing:-.03em;margin-top:24px}.hero-meta{font-size:13px;color:#b8c0cc;font-weight:750}.hero-meta span{color:#596474;margin:0 5px}.score-line{font-size:11px;color:#7f8a9a;margin-top:18px;letter-spacing:.12em}.score-line b{color:#fff;font-size:15px;margin-left:7px}.probabilities{display:flex;gap:54px;position:absolute;right:30px;bottom:74px}.probabilities div{display:flex;flex-direction:column;gap:5px}.probabilities span{font-size:9px;color:#6e7989;font-weight:800;letter-spacing:.12em}.probabilities b{font-size:18px}.probability-bar{position:absolute;left:30px;right:30px;bottom:28px;height:5px;background:#232a35;border-radius:9px;overflow:hidden}.probability-bar span{display:block;height:100%;background:var(--green)}.hero-stats{display:grid;grid-template-columns:1fr 1fr;gap:10px}.stat-card{border:1px solid var(--line);border-radius:12px;background:var(--panel);padding:18px;min-height:112px;display:flex;flex-direction:column;justify-content:space-between}.stat-card span{font-size:9px;color:#7e8999;letter-spacing:.14em;font-weight:900}.stat-card strong{font-size:23px}.stat-card.status strong{font-size:16px}
.thesis-card{border:1px solid var(--line);background:#080c11;border-radius:12px;padding:18px 20px;margin-top:12px}.thesis-card p{margin:8px 0;color:#d8dde5;font-size:13px;line-height:1.6}.generated{font-size:9px;color:#596474;letter-spacing:.12em}.section{margin-top:34px}.section-heading{display:flex;justify-content:space-between;align-items:flex-end;margin:7px 0 14px}.section-heading h2,h2{font-size:25px;line-height:1;margin:7px 0 0;letter-spacing:-.03em}.count-badge,.provider{font-size:9px;color:#8c97a7;letter-spacing:.12em;border:1px solid var(--line);border-radius:6px;padding:7px 9px;background:#090d12}.signal-layout,.evidence-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.signal-panel{border:1px solid var(--line);border-radius:12px;background:var(--panel);overflow:hidden}.panel-title,.evidence-title{font-size:11px;font-weight:900;letter-spacing:.11em;padding:14px 16px;border-bottom:1px solid var(--line)}.positive{color:var(--green)}.negative{color:var(--red)}.signal-row{display:flex;justify-content:space-between;gap:15px;padding:15px 16px;border-bottom:1px solid var(--line2)}.signal-row:last-child{border:0}.signal-name-line{display:flex;align-items:center;gap:8px}.signal-name-line strong{font-size:13px}.signal-dot{width:6px;height:6px;border-radius:50%;background:currentColor}.weight{font-size:8px;color:#5f6a79;border:1px solid #26303d;border-radius:4px;padding:2px 4px}.signal-main small{display:block;color:#788393;font-size:10px;line-height:1.45;margin-top:7px}.signal-score{font-size:16px;white-space:nowrap}.empty{padding:20px;color:#606b7a;font-size:11px}
.coverage-row{display:flex;align-items:center;gap:14px;margin:14px 0 18px;font-size:10px;color:#9ba5b4;font-weight:800;letter-spacing:.08em}.coverage-track{height:5px;max-width:360px;flex:1;background:#202833;border-radius:8px;overflow:hidden}.coverage-track span{display:block;height:100%;background:#8ca8c8}.evidence-title{border-radius:10px 10px 0 0;background:#090d12}.evidence-item{display:flex;gap:12px;padding:15px;border:1px solid var(--line);border-top:0;background:var(--panel)}.evidence-item p{margin:0;font-size:11px;color:#d3d8e0;line-height:1.45}.evidence-item small{display:block;color:#697585;margin-top:5px;font-size:9px}.liq-group-title{font-size:9px;font-weight:900;color:#677384;letter-spacing:.16em;margin:20px 0 9px}.liquidity-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.liquidity-card{border:1px solid var(--line);border-radius:10px;background:var(--panel);padding:14px}.liq-top,.liq-bottom{display:flex;justify-content:space-between}.liq-top{font-size:9px;color:#697586;letter-spacing:.12em;font-weight:800}.side-badge{font-size:8px;border:1px solid #29323e;padding:3px 5px;border-radius:4px}.liquidity-card.high .side-badge{color:var(--red)}.liquidity-card.low .side-badge{color:var(--green)}.liquidity-card strong{display:block;font-size:12px;margin-top:13px}.liq-price{font-size:23px;font-weight:800;margin:8px 0}.liq-bottom{font-size:9px;color:#667180;letter-spacing:.1em}.bottom-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:12px;margin-top:34px}.info-card{border:1px solid var(--line);border-radius:12px;background:var(--panel);padding:18px}.source-row{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--line2);font-size:10px}.source-row span{color:#657080;letter-spacing:.12em;font-weight:900}.source-row b{font-weight:700}.muted{font-size:10px;color:#6d7888}.invalidation{display:grid;grid-template-columns:30px 1fr;gap:9px;border-top:1px solid var(--line2);padding:11px 0;font-size:10px;line-height:1.4}.invalidation b{color:#5f6b7b}footer{display:flex;justify-content:space-between;border-top:1px solid var(--line);margin-top:38px;padding-top:16px;font-size:8px;letter-spacing:.13em;color:#596474}.error-banner{margin-top:12px;border:1px solid #4c2e32;background:#170d10;color:#ff9ca2;border-radius:8px;padding:9px 12px;font-size:10px}.loading{min-height:80vh;display:grid;place-items:center;color:#7f8a99;letter-spacing:.18em;font-size:11px}
@media(max-width:900px){.shell{width:min(100% - 24px,700px);padding-top:14px}.topbar{align-items:flex-start;gap:15px}.header-status{flex-wrap:wrap;justify-content:flex-end}.hero-grid,.signal-layout,.evidence-grid,.bottom-grid{grid-template-columns:1fr}.hero-copy{min-height:290px}.hero-stats{grid-template-columns:1fr 1fr}.liquidity-grid{grid-template-columns:1fr}footer{flex-direction:column;gap:7px}}
@media(max-width:520px){.brand-sub{display:none}.hero-copy{padding:22px}.hero-copy .direction{font-size:31px}.hero-stats{grid-template-columns:1fr}.probabilities{position:static;margin-top:38px;gap:30px}.section-heading{align-items:flex-start;gap:10px}.section-heading h2,h2{font-size:21px}}
