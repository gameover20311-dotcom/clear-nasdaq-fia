*{box-sizing:border-box}:root{--bg:#071019;--panel:#0d1823;--panel2:#111f2d;--line:#213243;--text:#edf4fa;--muted:#8fa4b7;--bull:#42d392;--bear:#ff6b78;--amber:#f7c65c;--blue:#6ab8ff}html,body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}body{min-height:100vh}button{background:#16283a;border:1px solid #2a4258;color:var(--text);border-radius:10px;padding:10px 15px;cursor:pointer}.shell{width:min(1500px,calc(100% - 28px));margin:0 auto;padding:24px 0 50px}.topbar,.sectionHead{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:18px}h1,h2{margin:3px 0;letter-spacing:-.03em}h1{font-size:clamp(28px,4vw,48px)}h2{font-size:28px}.eyebrow{font-size:11px;letter-spacing:.18em;color:#7aa7c7;font-weight:800}.subtitle,.metricSub,.signalDetail,.note,footer,small{color:var(--muted)}.topActions{display:flex;align-items:center;gap:10px}.statusDot,.phaseBadge{padding:9px 12px;border:1px solid var(--line);border-radius:999px;font-size:12px;font-weight:800}.statusDot.live{color:var(--bull)}.hero{display:grid;grid-template-columns:1.6fr .8fr;gap:24px;padding:26px;border-radius:20px;border:1px solid var(--line);background:linear-gradient(135deg,#0b1722,#0e2030);margin-bottom:16px}.hero.bullish{box-shadow:inset 4px 0 var(--bull)}.hero.bearish{box-shadow:inset 4px 0 var(--bear)}.heroDirection{font-size:clamp(38px,7vw,76px);font-weight:900;letter-spacing:-.05em;margin:5px 0 10px}.hero.bullish .heroDirection{color:var(--bull)}.hero.bearish .heroDirection{color:var(--bear)}.heroThesis{line-height:1.6;color:#b8c8d6}.probPanel{padding:18px;border:1px solid var(--line);background:rgba(0,0,0,.16);border-radius:16px;display:flex;flex-direction:column;justify-content:center}.bigProb{font-size:54px;font-weight:900}.probLabel{color:var(--muted);margin-bottom:15px}.probSplit{display:flex;justify-content:space-between;gap:12px;font-size:13px}.metricGrid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-bottom:16px}.metricGrid>.metric,.kvGrid .metric{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:15px}.metricLabel{color:var(--muted);font-size:11px;text-transform:uppercase}.metricValue{font-size:24px;font-weight:850;margin-top:5px}.metricSub{font-size:12px;margin-top:4px}.card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:18px;margin-bottom:16px}.cardTitle{font-size:13px;color:#a9bed0;text-transform:uppercase;letter-spacing:.1em;font-weight:800;margin-bottom:14px}.twoCol{display:grid;grid-template-columns:1fr 1fr;gap:16px}.list{display:grid;gap:9px}.item,.event,.healthRow,.compareBlock{padding:11px 12px;border-radius:10px;background:var(--panel2);border:1px solid #1e3040;font-size:13px}.bullLine{border-left:3px solid var(--bull)}.bearLine{border-left:3px solid var(--bear)}.risk{border-left:3px solid var(--amber)}.signalGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px 22px}.signalTop{display:flex;justify-content:space-between}.barTrack{height:6px;margin:8px 0;border-radius:99px;background:#1a2a39;overflow:hidden}.barFill{height:100%;border-radius:99px}.barFill.bull{background:var(--bull)}.barFill.bear{background:var(--bear)}.barFill.neutral{background:var(--amber)}.signalDetail{font-size:11px;line-height:1.45}.bull{color:var(--bull)}.bear{color:var(--bear)}.neutral{color:var(--amber)}.tickerGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.ticker{background:var(--panel2);border:1px solid #1e3040;border-radius:10px;padding:10px;display:flex;justify-content:space-between}.footerStats{display:flex;flex-wrap:wrap;gap:12px 18px;margin-top:14px;padding-top:12px;border-top:1px solid var(--line);color:var(--muted);font-size:12px}.kvGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.note{margin-top:10px;font-size:12px}.liquidityGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.liq{background:var(--panel2);border:1px solid #203143;border-radius:12px;padding:12px}.liqName{color:var(--muted);font-size:11px;text-transform:uppercase}.liqPrice{font-size:22px;font-weight:850;margin:5px 0}.liqMeta{display:flex;flex-wrap:wrap;gap:5px}.liqMeta span{background:#16283a;border-radius:999px;padding:4px 7px;font-size:10px;color:#aabccc}.event{display:grid;grid-template-columns:70px 1fr auto;gap:10px}.healthList{display:grid;gap:8px}.healthRow{display:flex;justify-content:space-between;gap:16px;font-size:12px}.healthRow span{color:var(--muted)}.healthRow b{text-align:right;overflow-wrap:anywhere}.sectionHead{margin-top:38px}.phaseBadge{color:var(--blue)}.confidenceCompare{display:grid;grid-template-columns:1fr 1fr;gap:18px}.confidenceRow{display:grid;grid-template-columns:1fr auto auto;gap:10px;padding:8px 0;border-bottom:1px solid #1d3041;font-size:12px}.compareBlock{display:grid;grid-template-columns:1.4fr .7fr .7fr .7fr;gap:10px;margin-bottom:8px}.tableWrap{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:12px}th,td{padding:10px 12px;text-align:left;border-bottom:1px solid #1e3040;white-space:nowrap}th{color:var(--muted);font-size:10px}.errorBox{background:rgba(255,107,120,.08);border:1px solid rgba(255,107,120,.3);border-radius:12px;color:#ffc0c6;padding:14px;margin-bottom:15px}.empty{color:var(--muted)}footer{text-align:center;font-size:11px;padding-top:24px}@media(max-width:1100px){.metricGrid{grid-template-columns:repeat(3,1fr)}.liquidityGrid{grid-template-columns:repeat(3,1fr)}}@media(max-width:760px){.topbar,.sectionHead{align-items:flex-start;flex-direction:column}.hero{grid-template-columns:1fr}.metricGrid,.twoCol,.signalGrid,.kvGrid,.confidenceCompare{grid-template-columns:1fr}.liquidityGrid{grid-template-columns:repeat(2,1fr)}.event,.compareBlock{grid-template-columns:1fr}}
