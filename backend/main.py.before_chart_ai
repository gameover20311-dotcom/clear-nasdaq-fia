from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

from fia.providers import ProviderHub
from fia.engine import build_forecast
from fia.liquidity import build_liquidity_map

app = FastAPI(title="CLEAR NASDAQ — FIA", version="2.0.0")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

hub = ProviderHub()


@app.get("/api/health")
async def health():
    return {
        "ok": True,
        "service": "CLEAR NASDAQ FIA",
        "version": "2.0.0",
    }


@app.get("/api/snapshot")
async def snapshot():
    return await hub.snapshot()


@app.get("/api/forecast")
async def forecast():
    snapshot_data = await hub.snapshot()
    return build_forecast(snapshot_data)


@app.get("/api/liquidity")
async def liquidity():
    snapshot_data = await hub.snapshot()
    data = snapshot_data.get("data", {})
    levels = build_liquidity_map(data)

    return {
        "status": snapshot_data.get("status"),
        "provider": snapshot_data.get("provider"),
        "timestamp": snapshot_data.get("timestamp"),
        "levels": {
            key: level.__dict__
            for key, level in levels.items()
        },
    }
