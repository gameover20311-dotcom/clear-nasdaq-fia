    # =========================================================
    # Finnhub candle
    # =========================================================

    async def finnhub_candles(
        self,
        symbol: str,
        resolution: str,
        start_ts: int,
        end_ts: int,
    ):
        """
        Get candles from Finnhub.

        If Finnhub fails (including HTTP 403), fall back to Polygon
        and normalize the response to Finnhub's t/h/l structure so
        existing downstream liquidity logic remains unchanged.
        """

        key = self.keys["FINNHUB_API_KEY"]

        # ---------------------------------------------------------
        # Primary: Finnhub
        # ---------------------------------------------------------
        if key:
            candles = await self.get(
                "https://" + "finnhub.io/api/v1/stock/candle",
                {
                    "symbol": symbol,
                    "resolution": resolution,
                    "from": start_ts,
                    "to": end_ts,
                    "token": key,
                },
                timeout=15,
            )

            if candles and candles.get("s") == "ok":
                return candles

            print(
                f"Finnhub candles unavailable for {symbol} "
                f"({resolution}); trying Polygon fallback."
            )

        # ---------------------------------------------------------
        # Fallback: Polygon
        # ---------------------------------------------------------
        polygon_key = self.keys["POLYGON_API_KEY"]

        if not polygon_key:
            print("Polygon fallback unavailable: POLYGON_API_KEY is missing.")
            return None

        # Map Finnhub resolutions to Polygon aggregates.
        resolution_map = {
            "D": ("1", "day"),
            "5": ("5", "minute"),
            "5m": ("5", "minute"),
            "15": ("15", "minute"),
            "15m": ("15", "minute"),
            "30": ("30", "minute"),
            "30m": ("30", "minute"),
            "60": ("60", "minute"),
            "60m": ("60", "minute"),
        }

        multiplier, timespan = resolution_map.get(
            str(resolution),
            ("1", "day"),
        )

        start_date = datetime.utcfromtimestamp(int(start_ts)).strftime("%Y-%m-%d")
        end_date = datetime.utcfromtimestamp(int(end_ts)).strftime("%Y-%m-%d")

        polygon_url = (
            f"https://api.polygon.io/v2/aggs/ticker/{symbol}/range/"
            f"{multiplier}/{timespan}/{start_date}/{end_date}"
        )

        polygon = await self.get(
            polygon_url,
            {
                "adjusted": "true",
                "sort": "asc",
                "limit": 50000,
                "apiKey": polygon_key,
            },
            timeout=15,
        )

        if not polygon:
            print(f"Polygon fallback failed for {symbol} ({resolution}).")
            return None

        results = polygon.get("results") or []

        if not results:
            print(f"Polygon returned no candles for {symbol} ({resolution}).")
            return None

        # Normalize Polygon milliseconds → Finnhub seconds.
        timestamps = []
        highs = []
        lows = []

        for row in results:
            try:
                ts_ms = row.get("t")
                high = row.get("h")
                low = row.get("l")

                if ts_ms is None or high is None or low is None:
                    continue

                timestamps.append(int(ts_ms) // 1000)
                highs.append(float(high))
                lows.append(float(low))

            except (TypeError, ValueError, OverflowError):
                continue

        if not timestamps:
            return None

        print(
            f"Polygon fallback active for {symbol} ({resolution}): "
            f"{len(timestamps)} candles."
        )

        return {
            "s": "ok",
            "t": timestamps,
            "h": highs,
            "l": lows,
        }

