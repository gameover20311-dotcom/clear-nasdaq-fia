            ]
        }

        self._snapshot_cache: Optional[Dict[str, Any]] = None
        self._snapshot_cache_time: float = 0.0

    # =========================================================
    # Generic HTTP
    # =========================================================

    async def get(
        self,
        url: str,
        params: Optional[dict] = None,
        timeout: float = 10,
    ):
        try:
            async with httpx.AsyncClient(timeout=timeout) as client:
                response = await client.get(url, params=params)
                response.raise_for_status()
                return response.json()

        except Exception as e:
            print(f"Provider error: {url} -> {e}")
            return None

    # =========================================================
    # Normalization helpers
    # =========================================================

    @staticmethod
    def clamp(value: float, low: float = -1.0, high: float = 1.0):
        return max(low, min(high, value))

    @staticmethod
    def normalize_change(change_percent):
        """
        Converts percentage change into approximately [-1, +1].

        Example:
          +2% -> +1
          -2% -> -1
          +1% -> +0.5
        """
        if change_percent is None:
            return None

        try:
            value = float(change_percent)
        except (TypeError, ValueError):
            return None

        return max(-1.0, min(1.0, value / 2.0))

    @staticmethod
    def normalize_yield(yield_value):
        """
        Higher yields are treated as negative pressure
        for NASDAQ / growth assets.
        """
        if yield_value is None:
            return None

        try:
            value = float(yield_value)
        except (TypeError, ValueError):
            return None

        return max(-1.0, min(1.0, -(value - 4.0) / 1.5))

    @staticmethod
    def safe_float(value):
        try:
            if value is None:
                return None
            return float(value)
        except (TypeError, ValueError):
            return None

