# CLEAR NASDAQ — FIA provider configuration
FINNHUB_API_KEY=
POLYGON_API_KEY=
FRED_API_KEY=
NEWS_API_KEY=
PRICEACTION_API_KEY=
GEMINI_API_KEY=

# SEC asks automated clients to identify themselves.
# Example: CLEAR-NASDAQ-FIA research your-email@example.com
SEC_USER_AGENT=

# SOL56 NEW FORWARD OOS PRE-MOVE VALIDATION
# One genuinely-new checkpoint per NY trading weekday. Missed windows are NOT backfilled.
FIA_FORWARD_OOS_ENABLED=1
FIA_FORWARD_OOS_CHECKPOINT_ET=13:00
FIA_FORWARD_OOS_GRACE_MINUTES=10
FIA_FORWARD_OOS_POLL_SECONDS=60
# Scientific promotion records require an explicit NQ quarterly contract, not NQ=F proxy.
FIA_FORWARD_OOS_REQUIRE_EXPLICIT_CONTRACT=1
